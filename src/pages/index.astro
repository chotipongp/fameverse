---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="hero-title">Welcome to the FameVerse!</h1>
      <p class="subtitle">
        💻 System Architect · 🎵 Music · 🏓 Table Tennis · 📸 Photography
      </p>
      <section class="intro">
        <p class="eyebrow">About Me</p>

        <h1>
          Building proactive systems<br />
          for global-scale platforms
        </h1>

        <p class="lead">
          With over <strong>6 years of experience</strong> transforming global infrastructure,
          I specialize in building full-stack platforms and microservices that are
          not just automated, but <strong>proactive</strong> — preventing outages
          before they happen while drastically reducing operational overhead.
        </p>
      </section>
      <section class="experience">
        <h2>Experience</h2>

        <!-- Company -->
        <div class="company">
          <div class="company-header">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/Exxon_Mobil_Logo.svg/1280px-Exxon_Mobil_Logo.svg.png"
              alt="ExxonMobil"
              width="40"
            />
            <div>
              <span class="company-meta">Full-time · 6 yrs 7 mos</span>
            </div>
          </div>

          <div class="timeline">
            <!-- Role -->
            <div class="role">
              <div class="marker">
                <span class="dot"></span>
                <span class="line"></span>
              </div>

              <div class="content">
                <h4>System Architect</h4>
              </div>
            </div>

            <!-- Role -->
            <div class="role">
              <div class="marker">
                <span class="dot"></span>
                <span class="line"></span>
              </div>

              <div class="content">
                <h4>Lead Developer</h4>
              </div>
            </div>

            <!-- Role -->
            <div class="role">
              <div class="marker">
                <span class="dot"></span>
              </div>

              <div class="content">
                <h4>Software Engineer</h4>
              </div>
            </div>
          </div>
        </div>

        <!-- Company -->
        <div class="company">
          <div class="company-header">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/22/Tencent_Logo.svg/1280px-Tencent_Logo.svg.png"
              alt="Tencent"
              title="Tencent"
            />
            <div>
              <span class="company-meta">Internship · 2 mos</span>
            </div>
          </div>

          <div class="timeline">
            <div class="role">
              <div class="marker">
                <span class="dot"></span>
              </div>

              <div class="content">
                <h4>Software Developer Intern</h4>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="tech-stack">
        <h2>Tech Stacks</h2>

        <div class="stack-group">
          <h3>Frontend</h3>
          <div class="logos">
            <img
              src="https://cdn.simpleicons.org/react"
              alt="React"
              title="React"
            />
            <img
              src="https://cdn.simpleicons.org/angular"
              alt="Angular"
              title="Angular"
            />
            <img
              src="https://cdn.simpleicons.org/typescript"
              alt="TypeScript"
              title="TypeScript"
            />
            <img
              src="https://cdn.simpleicons.org/javascript"
              alt="JavaScript"
              title="JavaScript"
            />
            <img
              src="https://cdn.simpleicons.org/jest"
              alt="Jest"
              title="Jest"
            />
            <img
              src="https://cdn.simpleicons.org/testinglibrary"
              alt="React Testing Library"
              title="React Testing Library"
            />
            <img
              src="https://cdn.simpleicons.org/jasmine"
              alt="Jasmine"
              title="Jasmine"
            />
          </div>
        </div>
        <div class="stack-group">
          <h3>Backend</h3>
          <div class="logos">
            <img
              src="https://cdn.simpleicons.org/springboot"
              alt="Spring Boot"
              title="Spring Boot"
            />
            <img
              src="https://cdn.simpleicons.org/openjdk"
              alt="Java"
              title="Java"
            />
            <img
              src="https://cdn.simpleicons.org/junit5"
              alt="JUnit 5"
              title="JUnit 5"
            />
            <img
              src="https://cdn.simpleicons.org/apachekafka"
              alt="Apache Kafka"
              title="Apache Kafka"
            />
          </div>
        </div>
        <div class="stack-group">
          <h3>Database</h3>
          <div class="logos">
            <img
              src="https://cdn.simpleicons.org/postgresql"
              alt="PostgreSQL"
              title="PostgreSQL"
            />
            <img
              src="https://api.iconify.design/simple-icons:microsoftsqlserver.svg"
              alt="Microsoft SQL Server"
              title="Microsoft SQL Server"
            />
            <img
              src="https://cdn.simpleicons.org/snowflake"
              alt="Snowflake"
              title="Snowflake"
            />
            <img
              src="https://cdn.simpleicons.org/redis"
              alt="Redis"
              title="Redis"
            />
          </div>
        </div>
        <div class="stack-group">
          <h3>Cloud & DevSecOps</h3>
          <div class="logos">
            <img
              src="https://api.iconify.design/simple-icons:microsoftazure.svg"
              alt="Microsoft Azure"
              title="Microsoft Azure"
            />
            <img
              src="https://cdn.simpleicons.org/redhatopenshift"
              alt="Red Hat OpenShift"
              title="Red Hat OpenShift"
            />
            <img
              src="https://cdn.simpleicons.org/k6"
              alt="k6"
              title="k6 Load Testing"
            />
            <img
              src="https://cdn.simpleicons.org/terraform"
              alt="Terraform"
              title="Terraform"
            />
            <img
              src="https://cdn.simpleicons.org/helm"
              alt="Helm"
              title="Helm"
            />
            <img
              src="https://cdn.simpleicons.org/githubactions"
              alt="GitHub Actions"
              title="GitHub Actions (CI/CD)"
            />
            <img
              src="https://cdn.simpleicons.org/datadog"
              alt="Datadog"
              title="Datadog Observability"
            />
          </div>
        </div>
      </section>
      <section class="specialties">
        <div class="card">
          <h3>Architecture</h3>
          <p>
            Designing scalable microservices and event-driven systems with a
            strong focus on reliability and long-term maintainability.
          </p>
          <span>Microservices · Event-Driven · Kafka</span>
        </div>

        <div class="card">
          <h3>Reliability & Automation</h3>
          <p>
            Shifting systems from reactive monitoring to proactive failure
            prevention using synthetic testing and automation.
          </p>
          <span>Synthetic Testing · Observability</span>
        </div>

        <div class="card">
          <h3>Platform Engineering</h3>
          <p>
            Building cloud-native platforms that reduce operational overhead and
            scale globally with confidence.
          </p>
          <span>Azure · Kubernetes · Terraform</span>
        </div>
      </section>
      <section class="skills">
        <h2>Skills</h2>

        <div class="grid">
          <div>
            <h4>Architecture</h4>
            <ul>
              <li>Microservices</li>
              <li>Event-Driven Architecture (Kafka)</li>
              <li>Synthetic Testing</li>
            </ul>
          </div>

          <div>
            <h4>Cloud & DevOps</h4>
            <ul>
              <li>Azure</li>
              <li>Kubernetes (AKS)</li>
              <li>Terraform, Helm, Docker</li>
            </ul>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  section {
    max-width: 960px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: #6366f1;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0.5rem 0 1rem;
    line-height: 1.2;
  }

  .lead {
    font-size: 1.1rem;
    color: #444;
    max-width: 720px;
  }

  .specialties {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .card {
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #fff;
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card span {
    display: block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .skills .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  h4 {
    margin-bottom: 0.5rem;
  }

  ul {
    padding-left: 1rem;
    color: #4b5563;
  }

  li {
    margin-bottom: 0.4rem;
  }

  .hero-title {
    font-size: clamp(2.8rem, 7vw, 4.2rem);
    font-weight: 800;
    background: linear-gradient(90deg, #6366f1, #22c55e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.03em;
  }

  .subtitle {
    font-weight: 400;
    letter-spacing: 0.4px;
    opacity: 0.7;
  }

  .tech-stack {
    max-width: 960px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }

  .tech-stack h2 {
    margin-bottom: 3rem;
  }

  .stack-group {
    margin-bottom: 3rem;
  }

  .stack-group h3 {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 1.2rem;
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(48px, 1fr));
    gap: 1.5rem;
    align-items: center;
  }

  .logos img {
    width: 36px;
    height: 36px;
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .logos img:hover {
    opacity: 1;
    transform: translateY(-2px) scale(1.05);
  }

  @media (prefers-color-scheme: dark) {
    .logos img {
      filter: invert(1);
    }
  }
  .experience {
    max-width: 900px;
    margin: 5rem auto;
  }

  .company {
    margin-bottom: 4rem;
  }

  .company-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .company-header img {
    width: 40px;
    height: 40px;
  }

  .company-meta {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .timeline {
    margin-top: 2rem;
  }

  .role {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .dot {
    width: 14px;
    height: 14px;
    background: #2563eb;
    border-radius: 50%;
    z-index: 2;
  }

  .line {
    position: absolute;
    top: 18px;
    bottom: -28px;
    width: 2px;
    background: #e5e7eb;
  }

  .role:last-child .line {
    display: none;
  }

  .content h4 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .meta {
    font-size: 0.85rem;
    color: #6b7280;
    margin: 0.2rem 0 0.8rem;
  }

  .content ul {
    padding-left: 1.2rem;
  }

  .content li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .company-header img {
    width: 10rem;
    height: auto;
    object-fit: contain;
  }
</style>
